# Server Port (assigned by hosting provider or default 5000)
PORT=5000

# Server Environment Mode (production / development)
NODE_ENV=production

# MongoDB Connection String (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/placementprep_ai?retryWrites=true&w=majority)
MONGODB_URI=

# Cryptographically Secure JWT Secret Key (minimum 32 characters)
JWT_SECRET=

# Token expiration duration
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin URL for CORS (e.g. https://placementprep-ai.vercel.app)
CLIENT_URL=

# Judge0 Code Execution API configuration (RapidAPI or self-hosted)
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# AI Provider Configuration (OpenAI or compatible API endpoint)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
